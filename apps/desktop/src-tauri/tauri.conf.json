{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VYRA",
  "version": "0.1.0",
  "identifier": "app.vyra.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VYRA",
        "width": 1320,
        "height": 840,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#141415",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
